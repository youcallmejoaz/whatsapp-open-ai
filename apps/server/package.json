{
  "name": "@wa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "simulate": "node --env-file-if-exists=../../.env scripts/simulate.ts",
    "import-chat": "node --env-file-if-exists=../../.env scripts/import-chat.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wa/shared": "workspace:*",
    "fastify": "^5.12.5",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "vitest": "^4.1.11"
  }
}
