{
  "name": "whatsapp-open-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @wa/server migrate",
    "seed": "pnpm --filter @wa/server seed",
    "simulate": "pnpm --filter @wa/server simulate",
    "import-chat": "pnpm --filter @wa/server import-chat"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
