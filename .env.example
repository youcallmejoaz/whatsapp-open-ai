# ---------------------------------------------------------------- server
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
LOG_LEVEL=info

# ---------------------------------------------------------------- dashboard login (first admin is created on boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
COOKIE_SECRET=replace-with-32-random-characters

# ---------------------------------------------------------------- WhatsApp Cloud API (Meta)
# mock = demo mode, nothing is sent to Meta. live = real Cloud API.
WA_MODE=mock
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# System-user token with whatsapp_business_messaging + whatsapp_business_management
WA_ACCESS_TOKEN=
# App secret (App settings → Basic): verifies X-Hub-Signature-256 on webhooks
WA_APP_SECRET=dev-app-secret
# Any string; paste the same value in the Meta webhook configuration
WA_VERIFY_TOKEN=dev-verify-token

# ---------------------------------------------------------------- AI
# mock = offline keyword stub for demos/tests. openai = real models.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_SMALL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Markdown file describing the business (hours, policies, tone). Defaults to the example.
BUSINESS_PROFILE_FILE=
# Language of summaries, action items and reports: en | ar
REPORT_LANGUAGE=en
AUTO_DRAFT=true
# Load demo conversations on boot when the database is empty (WA_MODE=mock only)
DEMO_SEED_ON_BOOT=false

# ---------------------------------------------------------------- scheduling & retention
REPORT_CRON=0 18 * * *
REPORT_TZ=Asia/Dubai
# Delete messages older than N days (0 = keep)
RETENTION_DAYS=0
