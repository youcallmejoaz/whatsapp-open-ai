# Environment variables for Render. Paste into: Render → your service → Environment → "Add from .env".
# Fill the blanks first. Blank secrets are treated as unset, and the app refuses to start in
# production without them, so a forgotten value fails loudly instead of running insecurely.
# Generate random secrets with:  openssl rand -hex 32
#
# Deployed with the Blueprint (render.yaml)? Render already generated COOKIE_SECRET,
# WA_VERIFY_TOKEN and WA_APP_SECRET. Delete those lines before pasting so blanks don't
# overwrite them.
#
# Not listed on purpose:
#   DATABASE_URL  set automatically by render.yaml from the Render database
#                 (add it yourself only for Supabase/Neon/another Postgres with pgvector)
#   PORT, HOST    set by Render and the Dockerfile
#   PUBLIC_URL    taken from RENDER_EXTERNAL_URL; set it only if you add a custom domain

# ---------------------------------------------------------------- required now (demo)
NODE_ENV=production
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECRET=
# Any random string; paste the same value into Meta → WhatsApp → Configuration → Webhook.
WA_VERIFY_TOKEN=
# Random for the demo; replace with your Meta App secret (App settings → Basic) when going live.
WA_APP_SECRET=

# Demo mode: fake WhatsApp outbox + offline AI stub, sample conversations on first boot.
WA_MODE=mock
AI_PROVIDER=mock
DEMO_SEED_ON_BOOT=true
REPORT_LANGUAGE=en

# ---------------------------------------------------------------- required to go live
# Switch WA_MODE=live and AI_PROVIDER=openai above, then fill these in.
# From Meta → your app → WhatsApp → API Setup:
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# System-user token with whatsapp_business_messaging + whatsapp_business_management (never expires):
WA_ACCESS_TOKEN=
# From platform.openai.com → API keys:
OPENAI_API_KEY=

# ---------------------------------------------------------------- optional (defaults shown)
# WA_GRAPH_VERSION=v23.0
# OPENAI_MODEL=gpt-5-mini
# OPENAI_MODEL_SMALL=gpt-5-nano
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# AUTO_DRAFT=true
# REPORT_CRON=0 18 * * *
# REPORT_TZ=Asia/Dubai
# RETENTION_DAYS=0
# SESSION_TTL_HOURS=12
# LOG_LEVEL=info
# PUBLIC_URL=https://inbox.yourdomain.com
